// General

window-rule {
  clip-to-geometry true
  draw-border-with-background false
  geometry-corner-radius 20
  // background-effect {
  //   blur true
  //   xray true
  // }
}

// Behavior

window-rule {
  match app-id=r#"org\.gnome\.NautilusPreviewer"#
  match app-id=r#"org\.gnome\.Nautilus"# title=r#"(?i)^Open(.*)"#

  match app-id="obsidian" title=r#"(?i)^Settings\s-\s(.*)\s-\sObsidian(.*)$"#
  match app-id="steam"    title=r#"(?i)^Friends\sList$"#
  match app-id="steam"    title=r#"(?i)^(.*)\s-\sChat$"#
  match app-id="blender"  title=r#"(?i)Preferences"#

  open-floating true
}

// Size

window-rule {
  match app-id=r#"(?i)^OpenTabletDriver\.UX\.Gtk$"#
  match app-id=r#"^md\.obsidian\.Obsidian$"#
  match app-id="brave-origin"
  match app-id="code"
  match app-id="spotify"
  match app-id="steam"
  match app-id="vesktop"

  open-maximized-to-edges false
  default-column-width { proportion 0.92; }
}

window-rule {
  match app-id="blockbench"
  match app-id="blender"
  match app-id=r#"org\.kde\.krita"#

  open-maximized-to-edges false
  open-maximized true
}

// Steam

window-rule {
  match app-id="steam" title=r#"(?i)^notificationtoasts_\d+_desktop$"#

  default-floating-position x=0 y=0 relative-to="bottom-right"
  geometry-corner-radius 0
}

window-rule {
  match app-id="steam" title=r#"(?i)^Steam\sBig\sPicture\sMode$"#

  open-fullscreen true
}

// Picture in Picture
window-rule {
  match title=r#"(?i)^picture\sin\spicture$"#

  default-floating-position x=6 y=6 relative-to="top-right"
  default-column-width { fixed 480; }
  default-window-height { fixed 270; }
  open-floating true
  open-focused false
  opacity 1.0
}

// Privacy

window-rule {
  match app-id=r#"^org\.keepassxc\.KeePassXC$"#
  match app-id=r#"^org\.gnome\.World\.Secrets$"#

  block-out-from "screen-capture"
}

// Layer

layer-rule {
  match namespace=r#"noctalia-backdrop"#
  // match namespace=r#"noctalia-wallpaper"#

  place-within-backdrop true
}

layer-rule {
  match namespace=r#"^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"#
  match namespace=r#"^noctalia-desktop-widget-(.*)$"#

  background-effect {
    xray false
  }
}

layer-rule {
  match namespace="noctalia-window-switcher"

  background-effect {
    blur false
  }
}