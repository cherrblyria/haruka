// -- Windows --

// General
window-rule {
  clip-to-geometry true
  draw-border-with-background false
  geometry-corner-radius 20
  // background-effect {
  //   blur true
  //   xray true
  // }
}

// Turn on shadows for floating windows.
window-rule {
  match is-floating=true
  shadow { on; }
}

// Open floating
window-rule {
  match app-id=r#"(?i)^org\.gnome\.Calculator$"#
  match app-id=r#"(?i)^org\.gnome\.Nautilus$"# title=r#"(?i)^Open(.*)"#
  match app-id=r#"(?i)^org\.gnome\.NautilusPreviewer$"#
  match app-id=r#"(?i)^org\.gnome\.clocks$"#

  match app-id="blender"  title=r#"(?i)^Preferences$"#
  match app-id="obsidian" title=r#"(?i)^Settings\s-\s(.*)\s-\sObsidian(.*)$"#
  match app-id="steam"    title=r#"(?i)^(.*)\s-\sChat$"#
  match app-id="steam"    title=r#"(?i)^Friends\sList$"#

  open-floating true
}

// Open maximize
window-rule {
  match app-id="blender"
  match app-id="blockbench"
  match app-id="brave"
  match app-id="brave-origin"
  match app-id="code"
  match app-id="spotify"
  match app-id="steam"
  match app-id="vesktop"
  match app-id=r#"(?i)^OpenTabletDriver\.UX\.Gtk$"#
  match app-id=r#"(?i)^ai\.opencode\.desktop$"#
  match app-id=r#"(?i)^md\.obsidian\.Obsidian$"#
  match app-id=r#"org\.kde\.krita"#

  open-maximized-to-edges false
  open-maximized true
}

// Steam notification
window-rule {
  match app-id="steam" title=r#"(?i)^notificationtoasts_\d+_desktop$"#

  default-floating-position x=0 y=0 relative-to="bottom-right"
  geometry-corner-radius 0
}

// Steam Big Picture mode
window-rule {
  match app-id="steam" title=r#"(?i)^Steam\sBig\sPicture\sMode$"#
  open-fullscreen true
}

// Picture in picture
window-rule {
  match title=r#"(?i)^picture\sin\spicture$"#

  default-floating-position x=6 y=6 relative-to="top-right"
  default-column-width { fixed 480; }
  default-window-height { fixed 270; }
  open-floating true
  open-focused false
  opacity 1.0
}

// Privacy
window-rule {
  match app-id=r#"^org\.keepassxc\.KeePassXC$"#
  match app-id=r#"^org\.gnome\.World\.Secrets$"#

  block-out-from "screen-capture"
}

// -- Layer --

// Noctalia's wallpaper backdrop
layer-rule {
  match namespace=r#"noctalia-backdrop"#
  // match namespace=r#"noctalia-wallpaper"#
  place-within-backdrop true
}

// Noctalia's widgets/panels
layer-rule {
  match namespace=r#"^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"#
  match namespace=r#"^noctalia-desktop-widget-(.*)$"#
  background-effect { xray false; }
}

// Noctalia's window switcher
layer-rule {
  match namespace="noctalia-window-switcher"
  background-effect { blur false; }
}